@model IEnumerable<WebApplication1.Models.Player>
@{
    ViewBag.Title = "Player List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="display-6 fw-bold text-primary">Player Information</h2>
        <a href="@Url.Action("Create","Players")" class="btn btn-primary shadow-sm">
            + Add New Player
        </a>
    </div>

    <div class="row">
        @foreach (var p in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header bg-white border-bottom-0 pt-3 pb-0 d-flex justify-content-between align-items-start">
                        <div class="d-flex align-items-center">
                            <img src="@p.Picture" width="60" height="60" class="rounded-circle border me-3" style="object-fit:cover;" />
                            <div>
                                <h5 class="mb-0 fw-bold">@Html.DisplayFor(x => p.PlayerName)</h5>
                                <small class="text-muted">Age: @Html.DisplayFor(x => p.Age)</small>
                            </div>
                        </div>
                        @if (p.IsCaptain)
                        {
                            <span class="badge bg-warning text-dark">Captain</span>
                        }
                    </div>

                    <div class="card-body">
                        <p class="card-text text-muted mb-2">
                            <i class="bi bi-calendar"></i> Born: @(p.BirthDate.ToString("yyyy-MM-dd"))
                        </p>

                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Team ID</th>
                                        <th>Team Name</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in p.PlayerEntries)
                                    {
                                        <tr>
                                            <td>@Html.DisplayFor(x => item.Team.TeamId)</td>
                                            <td>@Html.DisplayFor(x => item.Team.TeamName)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card-footer bg-white border-top-0 d-flex justify-content-end pb-3">
                        <a href="@Url.Action("Edit", "Players", new {id=p.PlayerId})" class="btn btn-outline-success btn-sm me-2 px-3">Edit</a>
                        <a href="@Url.Action("Delete", "Players", new {id=p.PlayerId})" class="btn btn-outline-danger btn-sm px-3">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
