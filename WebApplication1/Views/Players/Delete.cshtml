@model WebApplication1.Models.Player

@{
    ViewBag.Title = "Delete Player";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h2 class="text-danger text-center mb-4 display-6">Are you sure?</h2>

            <div class="alert alert-warning text-center">
                This will delete <strong>@Model.PlayerName</strong> and remove them from all assigned teams.
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <img src="@Model.Picture" width="120" height="120" class="rounded-circle border shadow-sm" style="object-fit:cover;" />
                        <h3 class="mt-3">@Html.DisplayFor(model => model.PlayerName)</h3>
                        <span class="badge bg-light text-dark border">Age: @Html.DisplayFor(model => model.Age)</span>
                    </div>

                    <div class="row">
                        <div class="col-6 text-end text-muted">Birth Date:</div>
                        <div class="col-6 fw-bold">@Model.BirthDate.ToString("dd-MM-yyyy")</div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-6 text-end text-muted">Captain Status:</div>
                        <div class="col-6 fw-bold">@(Model.IsCaptain ? "Yes" : "No")</div>
                    </div>

                    <hr class="my-4" />

                    <h5 class="text-secondary text-center mb-3">Assigned Teams</h5>
                    @if (Model.PlayerEntries.Any())
                    {
                        <div class="d-flex justify-content-center flex-wrap gap-2">
                            @foreach (var entry in Model.PlayerEntries)
                            {
                                <span class="badge bg-primary">@entry.Team.TeamName</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-center text-muted">No teams assigned.</p>
                    }
                </div>

                <div class="card-footer bg-white border-0 text-center pb-4">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        <a href="@Url.Action("Index")" class="btn btn-secondary px-4 me-2">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
