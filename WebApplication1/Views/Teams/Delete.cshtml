@model WebApplication1.Models.Team
@{
    ViewBag.Title = "Delete Team";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="text-danger text-center mb-4 display-6">Delete Team?</h2>

            <div class="alert alert-warning text-center">
                <strong>Warning:</strong> Deleting this team will remove all player assignments associated with it.
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-5 text-center">
                    <h5 class="text-muted mb-2">Team Name</h5>
                    <h3 class="fw-bold mb-4">@Html.DisplayFor(model => model.TeamName)</h3>

                    <div class="d-flex justify-content-center mt-4">
                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()
                            <a href="@Url.Action("Index")" class="btn btn-light px-4 me-2">Cancel</a>
                            <button type="submit" class="btn btn-danger px-5">Confirm Delete</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
